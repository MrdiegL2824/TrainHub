# Neon/Vercel injects DATABASE_URL in Preview and Production.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional local fallback when DATABASE_URL is not defined.
TRAINHUB_DB_HOST=localhost
TRAINHUB_DB_NAME=trainhub
TRAINHUB_DB_USER=root
TRAINHUB_DB_PASS=

# Recommended in Vercel so redirects and secure cookies use the public URL.
APP_URL=http://localhost/TrainHub
