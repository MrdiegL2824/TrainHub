{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/api/(auth|google-auth|suporte)\\.php$", "dest": "/api/index.php?path=/api/$1.php" },
    { "src": "^/(index|cadastro|admin-cadastrar-usuario|recuperar-senha|inicio|dashboard|admin-dashboard|admin-gerenciar|areas|treinamentos|treinamento-detalhe|aulas|aula-template|materiais|competencias|usuarios|logout)\\.php$", "dest": "/api/index.php?path=/$1.php" },
    { "src": "^/$", "dest": "/api/index.php?path=/index.php" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
